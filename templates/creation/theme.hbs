<label class="mwd-field">
  <span>{{localize "Name"}}</span>
  <input type="text" name="name" value="{{draft.name}}">
</label>
<label class="mwd-field">
  <span>{{localize "MWD.Creation.Theme"}}</span>
  <textarea name="theme" rows="3" placeholder="{{localize 'MWD.Creation.ThemePlaceholder'}}">{{draft.theme}}</textarea>
</label>
<label class="mwd-field">
  <span>{{localize "MWD.Tags.label"}}</span>
  <input type="text" name="tags" value="{{draft.tags}}" placeholder="{{localize 'MWD.Tags.placeholder'}}">
</label>
