<div class="mwd-grid-3">
  <label class="mwd-field"><span>{{localize "MWD.Details.rank"}}</span><input type="text" name="bio.rank" value="{{draft.bio.rank}}"></label>
  <label class="mwd-field"><span>{{localize "MWD.Details.age"}}</span><input type="text" name="bio.age" value="{{draft.bio.age}}"></label>
  <label class="mwd-field"><span>{{localize "MWD.Details.height"}}</span><input type="text" name="bio.height" value="{{draft.bio.height}}"></label>
  <label class="mwd-field"><span>{{localize "MWD.Details.weight"}}</span><input type="text" name="bio.weight" value="{{draft.bio.weight}}"></label>
</div>
<label class="mwd-field"><span>{{localize "MWD.Bio.history"}}</span>
  <textarea name="bio.history" rows="6">{{draft.bio.history}}</textarea></label>
<label class="mwd-field"><span>{{localize "MWD.Bio.personality"}}</span>
  <textarea name="bio.personality" rows="4">{{draft.bio.personality}}</textarea></label>
<label class="mwd-field"><span>{{localize "MWD.Bio.disposition"}}</span>
  <textarea name="bio.disposition" rows="3" placeholder="{{localize 'MWD.Bio.dispositionPlaceholder'}}">{{draft.bio.disposition}}</textarea></label>
