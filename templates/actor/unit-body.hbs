<div class="mwd-tab mwd-mech-body">
  <section class="mwd-block mwd-mech-pilot">
    <header class="mwd-block-header">
      <h3>{{localize "MWD.Mech.Pilot.label"}}</h3>
      {{#if editable}}
      <select data-pilot-select>{{selectOptions pilotChoices selected=system.pilot}}</select>
      {{/if}}
    </header>
    {{#if pilot}}
    {{> "systems/mechwarrior-destiny/templates/actor/parts/unit-person.hbs" person=pilot isPilot=true editable=editable}}
    {{else unless builtInCrew.seated}}
    <p class="mwd-empty">{{localize "MWD.Mech.Pilot.None"}}</p>
    {{/if}}
    {{> "systems/mechwarrior-destiny/templates/actor/parts/unit-crew.hbs" crew=builtInCrew system=system editable=editable}}
    {{#if hasCrew}}
    <header class="mwd-block-header">
      <h3>{{localize "MWD.Unit.Crew.label"}}</h3>
      {{#if editable}}<select data-crew-select>{{selectOptions crewChoices}}</select>{{/if}}
    </header>
    {{#each crew}}
    {{> "systems/mechwarrior-destiny/templates/actor/parts/unit-person.hbs" person=this editable=@root.editable}}
    {{else}}
    <p class="mwd-empty">{{localize "MWD.Unit.Crew.None"}}</p>
    {{/each}}
    {{/if}}
  </section>

  <section class="mwd-block mwd-mech-actions">
    <div class="mwd-header-row">
      {{#if isBattleArmor}}
      {{#if system.details.legAttack}}<button type="button" class="mwd-button" data-action="legAttack" data-tooltip="MWD.BattleArmor.legHint"><i class="fa-solid fa-shoe-prints"></i> {{localize "MWD.BattleArmor.LegAttack"}}</button>{{/if}}
      {{#if system.details.swarmAttack}}<button type="button" class="mwd-button" data-action="swarmAttack" data-tooltip="MWD.BattleArmor.swarmHint"><i class="fa-solid fa-hand-back-fist"></i> {{localize "MWD.BattleArmor.SwarmAttack"}}</button>{{/if}}
      {{#if system.attached.mode}}
      <button type="button" class="mwd-button" data-action="releaseSuit"><i class="fa-solid fa-person-arrow-down-to-line"></i> {{localize "MWD.BattleArmor.Release"}}</button>
      {{else}}
      <button type="button" class="mwd-button" data-action="mountSuit" data-tooltip="MWD.BattleArmor.MountHint"><i class="fa-solid fa-person-arrow-up-from-line"></i> {{localize "MWD.BattleArmor.Mount"}}</button>
      {{/if}}
      {{else}}
      {{#unless isFighter}}<button type="button" class="mwd-button" data-action="physical"><i class="fa-solid fa-hand-fist"></i> {{localize physicalLabel}}</button>{{/unless}}
      {{#if isMech}}{{#if system.details.jumpJets}}<button type="button" class="mwd-button" data-action="jump"><i class="fa-solid fa-jet-fighter-up"></i> {{localize "MWD.Mech.Jump"}}</button>{{/if}}{{/if}}
      <button type="button" class="mwd-button" data-action="piloting"><i class="fa-solid fa-person-falling"></i> {{localize "MWD.Mech.Piloting.Title"}}</button>
      {{#if isMech}}<button type="button" class="mwd-button" data-action="fall"><i class="fa-solid fa-person-falling-burst"></i> {{localize "MWD.Mech.Fall.Resolve"}}</button>{{/if}}
      {{#if swarmingSuits}}<button type="button" class="mwd-button" data-action="dislodge"><i class="fa-solid fa-hands-bubbles"></i> {{localize "MWD.BattleArmor.Dislodge"}}</button>{{/if}}
      {{#unless isMech}}<button type="button" class="mwd-button" data-action="crash"><i class="fa-solid fa-car-burst"></i> {{localize "MWD.Vehicle.Crash.Resolve"}}</button>{{/unless}}
      {{/if}}
      <button type="button" class="mwd-button mwd-roll-test" data-action="endNarration" data-tooltip="MWD.Mech.EndNarration.Hint"><i class="fa-solid fa-hourglass-end"></i> {{localize "MWD.Mech.EndNarration.Button"}}</button>
    </div>
    <div class="mwd-header-row mwd-statuses">
      {{#each statuses}}
      <a class="mwd-tag {{#if active}}active{{/if}}" data-action="toggleStatus" data-status="{{key}}">{{label}}</a>
      {{/each}}
    </div>
    {{#if attachedLabel}}<p class="mwd-small"><i class="fa-solid fa-link"></i> {{attachedLabel}}</p>{{/if}}
    {{#if mountedSuits}}<p class="mwd-small" data-tooltip="MWD.BattleArmor.CarryingHint"><i class="fa-solid fa-people-group"></i> {{localize "MWD.BattleArmor.Carrying" names=mountedSuits}}</p>{{/if}}
    {{#if swarmingSuits}}<p class="mwd-small mwd-wounds"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "MWD.BattleArmor.SwarmedBy" names=swarmingSuits}}</p>{{/if}}
  </section>

  <div class="mwd-columns">
    <div class="mwd-column">
      <section class="mwd-block">
        <header class="mwd-block-header">
          <h3>{{localize "MWD.Mech.Weapon.plural"}}</h3>
          {{#if editable}}<a class="mwd-icon-button" data-action="createItem" data-type="mechWeapon" data-tooltip="MWD.Mech.Weapon.Add"><i class="fa-solid fa-plus"></i></a>{{/if}}
        </header>
        <table class="mwd-mech-weapons">
          <thead>
            <tr>
              <th class="mwd-col-name">{{localize "MWD.Weapon.Name"}}</th>
              <th>{{localize "MWD.Weapon.Damage"}}</th>
              <th>{{localize "MWD.Mech.Weapon.TypeShort"}}</th>
              {{#if usesHeat}}<th>{{localize "MWD.Mech.Weapon.Heat"}}</th>{{/if}}
              <th>{{localize "MWD.Mech.Weapon.Loc"}}</th>
              {{#each rangeLabels}}<th class="mwd-range-col">{{this}}</th>{{/each}}
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#if isMech}}
            <tr class="mwd-muted">
              <td>{{localize "MWD.Mech.Physical.punch"}} / {{localize "MWD.Mech.Physical.kick"}}</td>
              <td>{{system.physical.punch}}/{{system.physical.kick}}</td>
              <td>—</td><td>—</td><td>—</td><td>OK</td><td>—</td><td>—</td><td>—</td><td></td>
            </tr>
            {{/if}}
            {{#if isVehicle}}
            <tr class="mwd-muted">
              <td>{{localize "MWD.Mech.Physical.ram"}}</td>
              <td>{{system.physical.ram}}</td>
              <td>—</td><td>—</td><td>OK</td><td>—</td><td>—</td><td>—</td><td></td>
            </tr>
            {{/if}}
            {{#each weapons}}
            <tr data-item-id="{{id}}" class="{{#if destroyed}}mwd-destroyed{{/if}}">
              <td class="mwd-col-name">
                <a class="mwd-rollable" data-action="fire" data-tooltip="MWD.Mech.Weapon.Fire"><i class="fa-solid fa-crosshairs"></i>
                {{#if primary}}<strong>{{localize "MWD.Mech.Weapon.PrimaryShort"}}:</strong> {{/if}}{{name}}</a>
              </td>
              <td>{{damage}}{{#if ammo}} <span class="mwd-muted">· {{ammo}}</span>{{/if}}</td>
              <td>{{types}}</td>
              {{#if @root.usesHeat}}<td>{{heat}}</td>{{/if}}
              <td>{{locations}}</td>
              {{#each ranges}}<td class="mwd-range-col">{{this}}</td>{{/each}}
              <td class="mwd-col-controls">
                <a data-action="toggleDestroyed" data-tooltip="MWD.Mech.Weapon.Destroyed"><i class="fa-solid fa-{{#if destroyed}}burst{{else}}circle-check{{/if}}"></i></a>
                <a data-action="editItem" data-tooltip="MWD.Edit"><i class="fa-solid fa-pen"></i></a>
                {{#if @root.editable}}<a data-action="deleteItem" data-tooltip="MWD.Delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
              </td>
            </tr>
            {{else}}
            <tr><td colspan="10" class="mwd-empty">{{localize "MWD.Mech.Weapon.None"}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      </section>

      <section class="mwd-block">
        <header class="mwd-block-header">
          <h3>{{localize "MWD.Mech.Equipment.label"}}</h3>
          {{#if editable}}<a class="mwd-icon-button" data-action="createItem" data-type="mechEquipment" data-tooltip="MWD.Mech.Equipment.Add"><i class="fa-solid fa-plus"></i></a>{{/if}}
        </header>
        <ol class="mwd-list">
          {{#each equipment}}
          <li class="mwd-list-row {{#if destroyed}}mwd-destroyed{{/if}}" data-item-id="{{id}}">
            <span class="mwd-col-name">
              {{#if apod}}<a class="mwd-rollable" data-action="fireAPod" data-tooltip="MWD.Clan.APod.Fire"><i class="fa-solid fa-burst"></i> {{name}}</a>{{else}}{{name}}{{/if}}
              {{#if location}} <span class="mwd-muted">({{location}}{{#if flags}}, {{flags}}{{/if}})</span>{{else if flags}} <span class="mwd-muted">({{flags}})</span>{{/if}}
            </span>
            {{#if shots.length}}<span class="mwd-pips mwd-shots">{{#each shots}}<a class="mwd-pip {{#if filled}}filled{{/if}}" data-action="shotPip" data-index="{{index}}" data-tooltip="MWD.Mech.Equipment.Shot"></a>{{/each}}</span>{{/if}}
            <span class="mwd-col-controls">
              <a data-action="toggleDestroyed" data-tooltip="MWD.Mech.Weapon.Destroyed"><i class="fa-solid fa-{{#if destroyed}}burst{{else}}circle-check{{/if}}"></i></a>
              <a data-action="editItem" data-tooltip="MWD.Edit"><i class="fa-solid fa-pen"></i></a>
              {{#if @root.editable}}<a data-action="deleteItem" data-tooltip="MWD.Delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
            </span>
          </li>
          {{else}}
          <li class="mwd-empty">{{localize "MWD.Mech.Equipment.None"}}</li>
          {{/each}}
        </ol>
      </section>

      {{#if isBattleArmor}}
      {{> "systems/mechwarrior-destiny/templates/actor/parts/battle-armor-weapons.hbs"}}
      {{/if}}

      <section class="mwd-block">
        <header class="mwd-block-header"><h3>{{localize "MWD.Notes"}}</h3></header>
        <prose-mirror name="system.notes" value="{{system.notes}}" toggled>{{{notesHTML}}}</prose-mirror>
      </section>
    </div>

    <div class="mwd-column mwd-column-narrow">
      {{#if usesHeat}}
      <section class="mwd-block">
        <header class="mwd-block-header">
          <h3>{{localize "MWD.Mech.Heat.label"}}</h3>
          <span class="mwd-muted">{{heatLevelLabel}}</span>
        </header>
        <div class="mwd-heat">
          {{#each heatPips}}<a class="mwd-pip heat {{level}} {{#if filled}}filled{{/if}}" data-action="heatPip" data-index="{{index}}"></a>{{/each}}
          <span class="mwd-muted">{{system.heat.value}} · {{localize "MWD.Mech.HeatDissipation"}} {{system.details.heatDissipation}}</span>
        </div>
        <p class="mwd-small mwd-muted">{{localize "MWD.Mech.Heat.CarriedHint" n=system.heat.level}}</p>
      </section>
      {{/if}}

      <section class="mwd-block">
        <header class="mwd-block-header">
          <h3>{{localize "MWD.Mech.ArmorDiagram"}}</h3>
          {{#if isVehicle}}{{#unless system.vtol}}
          <label class="checkbox mwd-turret-toggle" data-tooltip="MWD.Vehicle.HasTurretHint">
            <input type="checkbox" name="system.details.turret" {{checked system.details.turret}}> {{localize "MWD.Vehicle.HasTurret"}}
          </label>
          {{/unless}}{{/if}}
        </header>
        {{#if isBattleArmor}}
        {{> "systems/mechwarrior-destiny/templates/actor/parts/battle-armor-diagram.hbs"}}
        {{/if}}
        <div class="mwd-diagram mwd-diagram-{{actor.type}}">
          {{#each locations}}
          <div class="mwd-location mwd-location-{{key}} {{#if destroyed}}mwd-destroyed{{/if}}">
            <div class="mwd-location-head">
              <strong>{{label}}</strong> <span class="mwd-muted">({{rolls}})</span>
            </div>
            <div class="mwd-pips">
              {{#each armorPips}}<a class="mwd-pip armor {{#if filled}}filled{{/if}}" data-action="armorPip" data-location="{{../key}}" data-layer="armor" data-index="{{index}}"></a>{{/each}}
            </div>
            {{#if hasStructure}}
            <div class="mwd-pips">
              {{#each structurePips}}<a class="mwd-pip structure {{#if filled}}filled{{/if}}" data-action="armorPip" data-location="{{../key}}" data-layer="structure" data-index="{{index}}"></a>{{/each}}
            </div>
            {{/if}}
            {{#if @root.editable}}
            <div class="mwd-location-max">
              <input type="number" name="system.locations.{{key}}.armor" value="{{armor}}" min="0" data-tooltip="MWD.Mech.Armor">
              {{#if hasStructure}}
              /
              <input type="number" name="system.locations.{{key}}.structure" value="{{structure}}" min="0" data-tooltip="MWD.Mech.Structure">
              {{/if}}
            </div>
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{#if isFighter}}
        <div class="mwd-location mwd-fighter-structure">
          <div class="mwd-location-head"><strong>{{localize "MWD.Mech.Structure"}}</strong> <span class="mwd-muted">({{localize "MWD.Fighter.SharedStructure"}})</span></div>
          <div class="mwd-pips">
            {{#each structurePips}}<a class="mwd-pip structure {{#if filled}}filled{{/if}}" data-action="structurePip" data-index="{{index}}"></a>{{/each}}
          </div>
          {{#if editable}}<div class="mwd-location-max"><input type="number" name="system.structure.max" value="{{system.structure.max}}" min="0" data-tooltip="MWD.Mech.Structure"></div>{{/if}}
        </div>
        {{/if}}
        <p class="mwd-small mwd-muted">{{localize diagramHint}}</p>
      </section>

      {{#if hasCrits}}
      <section class="mwd-block">
        <header class="mwd-block-header"><h3>{{localize "MWD.Mech.Crit.label"}}</h3></header>
        {{#each critPips}}
        <div class="mwd-crit-row">
          <span>{{label}}</span>
          <span class="mwd-pips">{{#each pips}}<a class="mwd-pip {{#if filled}}filled{{/if}}" data-action="critPip" data-crit="{{../key}}" data-index="{{index}}"></a>{{/each}}</span>
        </div>
        {{/each}}
        {{#if isMech}}
        <div class="mwd-crit-row">
          <span>{{localize "MWD.Mech.Crit.LegShort"}}</span>
          <input type="number" name="system.crits.legs" value="{{system.crits.legs}}" min="0">
        </div>
        {{/if}}
        {{#if isVehicle}}
        <div class="mwd-crit-row">
          <span data-tooltip="MWD.Vehicle.MovementLostHint">{{localize "MWD.Vehicle.MovementLost"}}</span>
          <input type="number" name="system.crits.movement" value="{{system.crits.movement}}" min="0">
        </div>
        {{/if}}
      </section>
      {{/if}}
    </div>
  </div>
</div>
