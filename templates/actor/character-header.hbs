<header class="mwd-header">
  <img class="mwd-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
  <div class="mwd-header-main">
    <input class="mwd-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'Name'}}">
    <div class="mwd-header-row">
      <label class="mwd-field">
        <span>{{localize "MWD.Details.faction"}}</span>
        <input type="text" name="system.details.faction" value="{{system.details.faction}}">
      </label>
      <label class="mwd-field mwd-field-narrow">
        <span>{{localize "MWD.Details.experience"}}</span>
        <select name="system.details.experience">
          {{selectOptions experienceLevels selected=system.details.experience localize=true}}
        </select>
      </label>
      <label class="mwd-field mwd-field-xs">
        <span>{{localize "MWD.XP.label"}}</span>
        <input type="number" name="system.xp.value" value="{{system.xp.value}}" min="0">
      </label>
    </div>
    <div class="mwd-header-row mwd-resources">
      <div class="mwd-resource">
        <span class="mwd-resource-label">{{localize "MWD.PlotPoints.label"}}</span>
        <button type="button" class="mwd-icon-button" data-action="plotPoint" data-delta="-1" data-tooltip="MWD.PlotPoints.spend"><i class="fa-solid fa-minus"></i></button>
        <span class="mwd-tokens">
          {{#each plotPointPips}}<span class="mwd-token {{#if filled}}filled{{/if}}"></span>{{/each}}
        </span>
        <button type="button" class="mwd-icon-button" data-action="plotPoint" data-delta="1" data-tooltip="MWD.PlotPoints.gain"><i class="fa-solid fa-plus"></i></button>
      </div>
      <div class="mwd-resource">
        <span class="mwd-resource-label" data-tooltip="MWD.Edge.hint">{{localize "MWD.Edge.label"}}</span>
        <span class="mwd-pips">
          {{#each edgePips}}<a class="mwd-pip edge {{#if spent}}filled{{/if}}" data-action="edgePip" data-index="{{index}}"></a>{{/each}}
        </span>
        <span class="mwd-muted">{{localize "MWD.Edge.remaining" n=system.edge.remaining}}</span>
      </div>
      {{#if woundModifier}}
      <div class="mwd-resource mwd-wounds" data-tooltip="MWD.Condition.WoundsHint">
        <i class="fa-solid fa-droplet"></i> {{localize "MWD.Condition.Wounds"}} {{mwdSigned woundModifier}}
      </div>
      {{/if}}
      <button type="button" class="mwd-button mwd-roll-test" data-action="rollTest"><i class="fa-solid fa-dice"></i> {{localize "MWD.Test.Button"}}</button>
    </div>
  </div>
</header>
