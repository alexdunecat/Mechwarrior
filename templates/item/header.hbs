<header class="mwd-header mwd-item-header">
  <img class="mwd-portrait small" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
  <div class="mwd-header-main">
    <input class="mwd-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize 'Name'}}">
    <span class="mwd-muted">{{localize (concat "TYPES.Item." item.type)}}</span>
  </div>
</header>
