<div class="mwd-item-body">
  <label class="checkbox"><input type="checkbox" name="system.primary" {{checked system.primary}}> {{localize "MWD.Mech.Weapon.Primary"}}</label>
  <p class="hint">{{localize "MWD.Mech.Weapon.PrimaryHint"}}</p>
  <div class="form-group">
    <label>{{localize "MWD.Weapon.Damage"}}</label>
    <div class="form-fields">
      <input type="number" name="system.damage" value="{{system.damage}}" min="0" data-tooltip="MWD.Mech.Weapon.Base">
      <span>+ M ×</span>
      <input type="number" name="system.missiles" value="{{system.missiles}}" min="0" max="4" data-tooltip="MWD.Mech.Weapon.Missiles">
      <span>Max</span>
      <input type="number" name="system.maxDamage" value="{{system.maxDamage}}" min="0" data-tooltip="MWD.Mech.Weapon.Max">
    </div>
    <p class="hint">{{localize "MWD.Mech.Weapon.DamageHint"}} <strong>{{system.damageLabel}}</strong></p>
  </div>
  <label class="checkbox"><input type="checkbox" name="system.heatAlternative" {{checked system.heatAlternative}}> {{localize "MWD.Mech.Weapon.HeatAlternative"}}</label>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Weapon.Types"}}</label>
    <input type="text" name="system.types" value="{{system.types}}" placeholder="E, M">
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Weapon.Heat"}}</label>
    <input type="number" name="system.heat" value="{{system.heat}}" min="0" max="6">
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Weapon.Locations"}}</label>
    <div class="form-fields mwd-checkboxes">
      {{#each mechLocations}}<label class="checkbox"><input type="checkbox" name="system.mounts.{{key}}" {{checked checked}}> {{label}}</label>{{/each}}
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Weapon.Ranges"}}</label>
    <div class="form-fields mwd-ranges">
      {{#each mechRanges}}<label>{{label}} <select name="system.ranges.{{key}}">{{selectOptions @root.rangeCodes selected=value}}</select></label>{{/each}}
    </div>
  </div>
  <label class="checkbox"><input type="checkbox" name="system.destroyed" {{checked system.destroyed}}> {{localize "MWD.Mech.Weapon.Destroyed"}}</label>
  {{> "systems/mechwarrior-destiny/templates/item/description.hbs"}}
</div>
