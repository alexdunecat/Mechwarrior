<div class="mwd-dialog-body">
  <div class="form-group">
    <label>{{localize "MWD.XP.label"}}</label>
    <input type="number" name="amount" value="1" min="1" step="1" autofocus>
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Advance.Reason"}}</label>
    <input type="text" name="reason" placeholder="{{localize 'MWD.Advance.ReasonPlaceholder'}}">
  </div>
  <p class="hint">{{localize "MWD.Advance.AwardHint"}}</p>
</div>
