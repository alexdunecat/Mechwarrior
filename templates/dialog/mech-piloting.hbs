<div class="mwd-dialog-body">
  <div class="form-group">
    <label>{{localize "MWD.Test.Difficulty"}}</label>
    <select name="difficulty">
      {{#each difficulties}}<option value="{{value}}" {{#if (eq value "average")}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Test.Modifier"}}</label>
    <input type="number" name="modifier" value="0" min="-3" max="3" step="1">
  </div>
  {{#if penalty}}<p class="mwd-wounds">{{localize penalty.label}} {{mwdSigned penalty.value}}</p>{{/if}}
</div>
