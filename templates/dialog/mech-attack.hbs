<div class="mwd-dialog-body">
  <p><strong>{{weapon.name}}</strong> — {{localize "MWD.Weapon.Damage"}} {{weapon.system.damageLabel}} · {{localize "MWD.Mech.Weapon.Heat"}} {{weapon.system.heatLabel}} · {{localize "MWD.Mech.Attack.Gunnery"}} {{mwdSigned gunnery}}</p>
  {{#if targets.length}}
  <p>{{localize "MWD.Attack.Targets"}}: {{#each targets}}<span class="mwd-tag">{{name}} ({{mwdSigned defense}}){{#if disengaged}} · {{localize "MWD.Unit.Status.disengaged"}}{{/if}}{{#if person}} · {{localize "MWD.Mixed.SmallTargetShort"}}{{/if}}</span> {{/each}}</p>
  {{else}}
  <p class="hint">{{localize "MWD.Mech.Attack.NoTarget"}}</p>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Attack.ManualDefense"}}</label>
    <input type="number" name="manualDefense" value="5" step="1">
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "MWD.Attack.Range"}}</label>
    <select name="range">
      {{#each ranges}}<option value="{{value}}" {{#if (eq value @root.range)}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Terrain.label"}}</label>
    <select name="terrain">{{#each terrains}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
  </div>
  {{#if jumped}}
  <div class="form-group">
    <label>{{localize "MWD.Mech.Attack.JumpTarget"}}</label>
    <select name="jumpTarget">
      <option value="">—</option>
      {{#each targets}}<option value="{{id}}">{{name}}</option>{{/each}}
    </select>
    <p class="hint">{{localize "MWD.Mech.Attack.JumpTargetHint"}}</p>
  </div>
  {{/if}}
  {{#if weapon.system.heatAlternative}}
  <label class="checkbox"><input type="checkbox" name="heatInstead"> {{localize "MWD.Mech.Attack.HeatInstead"}}</label>
  {{/if}}
  <div class="form-group">
    <label>{{localize "MWD.Test.Modifier"}}</label>
    <input type="number" name="modifier" value="0" min="-3" max="3" step="1">
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Attack.DefenseModifier"}}</label>
    <input type="number" name="defenseModifier" value="0" min="-3" max="3" step="1">
  </div>
  <p class="hint">{{localize "MWD.Mech.Attack.AutoHint"}}{{#if heatRanged}} {{localize "MWD.Mech.Attack.HeatPenalty" n=heatRanged}}{{/if}}</p>
</div>
