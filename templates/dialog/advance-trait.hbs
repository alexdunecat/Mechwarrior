<div class="mwd-dialog-body">
  <p class="hint">{{localize "MWD.Advance.BuyTraitHint" cost=cost}}</p>
  <div class="form-group">
    <label>{{localize "MWD.Advance.BookTrait"}}</label>
    <select name="key">
      <option value="">{{localize "MWD.Advance.CustomTrait"}}</option>
      {{#each choices}}<option value="{{value}}">{{label}}</option>{{/each}}
    </select>
  </div>
  <fieldset>
    <legend>{{localize "MWD.Advance.CustomTrait"}}</legend>
    <div class="form-group">
      <label>{{localize "Name"}}</label>
      <input type="text" name="name">
    </div>
    <div class="form-group">
      <label>{{localize "MWD.Trait.Modifier"}}</label>
      <input type="number" name="modifier" value="0" min="0" max="1">
    </div>
    <div class="form-group">
      <label>{{localize "MWD.Trait.AppliesTo"}}</label>
      <input type="text" name="appliesTo">
    </div>
  </fieldset>
</div>
