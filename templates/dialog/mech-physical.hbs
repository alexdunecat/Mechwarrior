<div class="mwd-dialog-body">
  {{#if targets.length}}
  <p>{{localize "MWD.Attack.Targets"}}: {{#each targets}}<span class="mwd-tag">{{this}}</span> {{/each}}</p>
  {{else}}
  <p class="hint">{{localize "MWD.Mech.Attack.NoTarget"}}</p>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Attack.ManualDefense"}}</label>
    <input type="number" name="manualDefense" value="5" step="1">
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "MWD.Mech.Physical.Type"}}</label>
    <select name="type">
      {{#each types}}<option value="{{value}}" {{#if (eq value @root.type)}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}
    </select>
    <p class="hint">{{localize "MWD.Mech.Physical.Hint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Physical.Movement"}}</label>
    <input type="number" name="movement" value="1" min="0" step="1">
    <p class="hint">{{localize "MWD.Mech.Physical.MovementHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Mech.Terrain.label"}}</label>
    <select name="terrain">{{#each terrains}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Test.Modifier"}}</label>
    <input type="number" name="modifier" value="0" min="-3" max="3" step="1">
  </div>
  <div class="form-group">
    <label>{{localize "MWD.Attack.DefenseModifier"}}</label>
    <input type="number" name="defenseModifier" value="0" min="-3" max="3" step="1">
  </div>
</div>
